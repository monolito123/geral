#!/bin/busybox sh
# SPDX-License-Identifier: Apache-2.0
# Stage 1 of the minimal Linux test target. It runs from the initramfs, which
# stands in for a bootloader-verified boot image: it carries the release
# public key. It accepts dm-verity root hashes only from boot metadata signed
# by that key, and refuses to continue otherwise.
#
# Test scaffolding, not NottOS product code. See README.md.

/bin/busybox mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
export PATH=/sbin:/bin
# No udev here: let libdevmapper create device nodes itself.
export DM_DISABLE_UDEV=1

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run

say() {
    echo "NOTT-MINI: $*"
}

halt() {
    say "$*"
    say "HALT"
    poweroff -f
}

while read -r module; do
    insmod "/modules/$module" || halt "FAIL stage1: insmod $module"
done </modules/order

# Boot metadata: four zero-padded 64 KiB slots on an untrusted disk. Nothing
# in them is interpreted until the signature has been checked.
mkdir /run/meta
slot() {
    dd if=/dev/vde bs=65536 skip="$1" count=1 2>/dev/null |
        tr -d '\000' >"/run/meta/$2"
}
slot 0 boot-metadata
slot 1 boot-metadata.sig
slot 2 system.roothash
slot 3 attest.roothash
/sbin/nott-tools manifest verify /run/meta/boot-metadata --dir /run/meta \
    --only system.roothash,attest.roothash --context boot-metadata \
    --public-key /etc/nott/release.public \
    --signature /run/meta/boot-metadata.sig ||
    halt "FAIL stage1: boot metadata is not authentic"

# System image: read-only, every block checked against the root hash that
# the signed manifest vouches for.
/sbin/veritysetup open /dev/vda system /dev/vdb "$(cat /run/meta/system.roothash)" ||
    halt "FAIL stage1: verity open"
mount -t erofs -o ro /dev/mapper/system /system ||
    halt "FAIL stage1: mount system"

# Integrity folder: its own verified, read-only image.
/sbin/veritysetup open /dev/vdf attest /dev/vdg "$(cat /run/meta/attest.roothash)" ||
    halt "FAIL stage1: verity open attest"
mount -t erofs -o ro,nosuid,nodev,noexec /dev/mapper/attest /system/nott/attest ||
    halt "FAIL stage1: mount attest"

# Data partition: encrypted as a whole, the way metadata encryption wraps
# user data on a phone. The key is a test key (see build.sh).
/sbin/cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 \
    --key-file /etc/nott/metadata.key /dev/vdc data ||
    halt "FAIL stage1: data open"

for dir in dev proc sys run; do
    mount -o move "/$dir" "/system/$dir" || halt "FAIL stage1: move /$dir"
done
exec switch_root /system /sbin/init
